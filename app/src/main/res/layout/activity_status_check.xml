<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FC"
    android:padding="24dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardIconContainer"
        android:layout_width="110dp"
        android:layout_height="110dp"
        app:cardCornerRadius="55dp"
        app:cardBackgroundColor="#E6ECF8"
        app:strokeWidth="0dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvStatusTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed">

        <ImageView
            android:id="@+id/ivShieldIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/bg_pill_badge_teal"
            app:tint="#266153"
            android:layout_gravity="center"/>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvStatusTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Are you feeling\nokay?"
        android:textColor="#111827"
        android:textSize="32sp"
        android:textStyle="bold"
        android:gravity="center"
        android:lineSpacingMultiplier="1.1"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/cardIconContainer"
        app:layout_constraintBottom_toTopOf="@id/tvStatusDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvStatusDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="You are about to end the current evaluation session. By confirming, you indicate that you are physically well and no longer require immediate monitoring."
        android:textColor="#4B5563"
        android:textSize="16sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvStatusTitle"
        app:layout_constraintBottom_toTopOf="@id/btnYesOkay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnYesOkay"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Yes, I'm okay"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        app:backgroundTint="#266153"
        app:cornerRadius="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/btnNoContinue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNoContinue"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="No, continue test"
        android:textColor="#266153"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        app:strokeColor="#266153"
        app:strokeWidth="2dp"
        app:cornerRadius="12dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>