<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FC">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/profileHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/left_arrow"
            android:clickable="true"
            android:focusable="true"
            app:tint="#266153"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User Profile"
            android:textColor="#266153"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/notification"
            app:tint="#266153"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/profileHeader"
        app:layout_constraintBottom_toTopOf="@id/btnSaveChanges"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/avatarContainer"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/circle_background" />

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/profile"
                    app:tint="#9CA3AF"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/camera"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPersonalInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="16dp"
                app:strokeWidth="0dp"
                app:cardElevation="2dp"
                app:layout_constraintTop_toBottomOf="@id/avatarContainer">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvPersonalLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PERSONAL INFORMATION"
                        android:textColor="#266153"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <ImageView
                        android:id="@+id/btnEditPersonalInfo"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/edit"
                        app:tint="#4B5563"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView android:id="@+id/lblAge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Age" android:textColor="#6B7280" android:textSize="13sp" android:layout_marginTop="16dp" app:layout_constraintTop_toBottomOf="@id/tvPersonalLabel" app:layout_constraintStart_toStartOf="parent"/>
                    <TextView android:id="@+id/lblGender" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gender" android:textColor="#6B7280" android:textSize="13sp" app:layout_constraintTop_toTopOf="@id/lblAge" app:layout_constraintStart_toStartOf="parent" android:layout_marginStart="180dp"/>
                    <TextView android:id="@+id/lblHeight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Height" android:textColor="#6B7280" android:textSize="13sp" android:layout_marginTop="20dp" app:layout_constraintTop_toBottomOf="@id/lblAge" app:layout_constraintStart_toStartOf="parent"/>
                    <TextView android:id="@+id/lblWeight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Weight" android:textColor="#6B7280" android:textSize="13sp" app:layout_constraintTop_toTopOf="@id/lblHeight" app:layout_constraintStart_toStartOf="@id/lblGender"/>

                    <View android:id="@+id/div1" android:layout_width="match_parent" android:layout_height="1dp" android:background="#E5E7EB" android:layout_marginTop="16dp" app:layout_constraintTop_toBottomOf="@id/lblHeight"/>

                    <TextView android:id="@+id/lblAddress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Residential Address" android:textColor="#6B7280" android:textSize="13sp" android:layout_marginTop="12dp" app:layout_constraintTop_toBottomOf="@id/div1" app:layout_constraintStart_toStartOf="parent"/>
                    <View android:id="@+id/div2" android:layout_width="match_parent" android:layout_height="1dp" android:background="#E5E7EB" android:layout_marginTop="16dp" app:layout_constraintTop_toBottomOf="@id/lblAddress"/>

                    <TextView android:id="@+id/lblConditions" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Relevant Medical Conditions" android:textColor="#6B7280" android:textSize="13sp" android:layout_marginTop="12dp" app:layout_constraintTop_toBottomOf="@id/div2" app:layout_constraintStart_toStartOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEmergencySettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:strokeWidth="0dp"
                app:cardElevation="2dp"
                app:layout_constraintTop_toBottomOf="@id/cardPersonalInfo">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvSettingsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EMERGENCY SETTINGS"
                        android:textColor="#266153"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <ImageView
                        android:id="@+id/btnEditEmergencySettings"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/edit"
                        app:tint="#4B5563"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/rowPrimaryAction"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/rectangle"
                        android:paddingHorizontal="16dp"
                        app:layout_constraintTop_toBottomOf="@id/tvSettingsLabel">

                        <ImageView
                            android:id="@+id/ivIconVoice"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/speak"
                            app:tint="#266153"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"/>

                        <TextView
                            android:id="@+id/tvVoiceTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Primary Action"
                            android:textColor="#111827"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginStart="12dp"
                            app:layout_constraintStart_toEndOf="@id/ivIconVoice"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toTopOf="@id/tvVoiceSubtitle"
                            app:layout_constraintVertical_chainStyle="packed"/>

                        <TextView
                            android:id="@+id/tvVoiceSubtitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Automated Voice Call"
                            android:textColor="#4B5563"
                            android:textSize="12sp"
                            app:layout_constraintStart_toStartOf="@id/tvVoiceTitle"
                            app:layout_constraintTop_toBottomOf="@id/tvVoiceTitle"
                            app:layout_constraintBottom_toBottomOf="parent"/>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/play"
                            app:tint="#4B5563"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/rowAlertDelay"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/rectangle"
                        android:paddingHorizontal="16dp"
                        app:layout_constraintTop_toBottomOf="@id/rowPrimaryAction">

                        <ImageView
                            android:id="@+id/ivIconTimer"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/timer"
                            app:tint="#266153"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"/>

                        <TextView
                            android:id="@+id/tvTimerTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Auto-Alert Delay"
                            android:textColor="#111827"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginStart="12dp"
                            app:layout_constraintStart_toEndOf="@id/ivIconTimer"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toTopOf="@id/tvTimerSubtitle"
                            app:layout_constraintVertical_chainStyle="packed"/>

                        <TextView
                            android:id="@+id/tvTimerSubtitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="30 Seconds"
                            android:textColor="#4B5563"
                            android:textSize="12sp"
                            app:layout_constraintStart_toStartOf="@id/tvTimerTitle"
                            app:layout_constraintTop_toBottomOf="@id/tvTimerTitle"
                            app:layout_constraintBottom_toBottomOf="parent"/>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/play"
                            app:tint="#4B5563"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvNotificationSettings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        app:layout_constraintTop_toBottomOf="@id/rowAlertDelay"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        tools:listitem="@layout/item_notification_setting" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveChanges"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Save Changes"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        app:backgroundTint="#266153"
        app:cornerRadius="12dp"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>