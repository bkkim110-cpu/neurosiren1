<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeWidth="0dp"
    app:cardElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStatusIconContainer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="#E6ECF8"
            app:strokeWidth="0dp"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/ivStatusRowIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/profile"
                app:tint="#266153"
                android:layout_gravity="center"/>
        </com.google.android.material.card.MaterialCardView>

        <ImageView
            android:id="@+id/ivTrailingCheck"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/check"
            app:tint="#266153"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/tvStatusRowTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:textColor="#111827"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/ivTrailingCheck"
            app:layout_constraintStart_toEndOf="@id/cardStatusIconContainer"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/tvStatusRowTime"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="911 notified" />

        <TextView
            android:id="@+id/tvStatusRowTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="2dp"
            android:textColor="#4B5563"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@id/ivTrailingCheck"
            app:layout_constraintStart_toEndOf="@id/cardStatusIconContainer"
            app:layout_constraintTop_toBottomOf="@id/tvStatusRowTitle"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="Dispatched at 10:42 AM" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>